<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.knietty.host</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KNIETTY_EXECUTABLE__</string>
    <string>--device</string>
    <string>auto</string>
    <string>--cols</string>
    <string>50</string>
    <string>--rows</string>
    <string>22</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/knietty.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/knietty.log</string>
</dict>
</plist>
